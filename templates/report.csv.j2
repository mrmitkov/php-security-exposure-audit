{%- macro csv_cell(value) -%}
{%- set cell = (value | default('', true) | string | replace('\r', ' ') | replace('\n', ' ') | replace('"', '""')) -%}
{%- if cell and cell[0] in ['=', '+', '-', '@', '\t'] %}{% set cell = "'" ~ cell %}{% endif -%}
"{{ cell }}"
{%- endmacro %}"inventory_hostname","hostname","fqdn","primary_ip","ip_addresses","operating_system","kernel","uptime_seconds","php_installed","php_detection_status","php_version","php_ini_setting","php_ini_setting_error","php_ini_scope","php_cgi_installed","php_cgi_binaries","php_fpm_installed","php_fpm_binaries","php_packages","apache_installed","apache_active","nginx_installed","nginx_active","tomcat_installed","tomcat_active","websphere_installed","websphere_active","listening_tcp_ports","php_file_count","php_directories","war_file_count","war_deployment_directories","document_roots_found","classification","docker_running_container_count","podman_running_container_count","lxc_classic_running_container_count","lxd_running_container_count","kubernetes_pod_count","docker_scan_status","podman_scan_status","lxc_classic_scan_status","lxd_scan_status","kubernetes_scan_status","runtime_container_results","audit_data_source","audit_data_timestamp"
{% for audit in audit_report_hosts | default([]) %}{{ csv_cell(audit.inventory_hostname) }},{{ csv_cell(audit.hostname) }},{{ csv_cell(audit.fqdn) }},{{ csv_cell(audit.primary_ip) }},{{ csv_cell(audit.ip_addresses | join('; ')) }},{{ csv_cell(audit.operating_system) }},{{ csv_cell(audit.kernel) }},{{ csv_cell(audit.uptime_seconds) }},{{ csv_cell(audit.php_installed) }},{{ csv_cell(audit.php_detection_status) }},{{ csv_cell(audit.php_version) }},{{ csv_cell(audit.php_ini_setting) }},{{ csv_cell(audit.php_ini_setting_error) }},{{ csv_cell(audit.php_ini_scope) }},{{ csv_cell(audit.php_cgi_installed) }},{{ csv_cell(audit.php_cgi_binaries | join('; ')) }},{{ csv_cell(audit.php_fpm_installed) }},{{ csv_cell(audit.php_fpm_binaries | join('; ')) }},{{ csv_cell(audit.php_packages | join('; ')) }},{{ csv_cell(audit.apache_installed) }},{{ csv_cell(audit.apache_active) }},{{ csv_cell(audit.nginx_installed) }},{{ csv_cell(audit.nginx_active) }},{{ csv_cell(audit.tomcat_installed) }},{{ csv_cell(audit.tomcat_active) }},{{ csv_cell(audit.websphere_installed) }},{{ csv_cell(audit.websphere_active) }},{{ csv_cell(audit.listening_tcp_ports | join('; ')) }},{{ csv_cell(audit.php_file_count) }},{{ csv_cell(audit.php_directories | join('; ')) }},{{ csv_cell(audit.war_file_count) }},{{ csv_cell(audit.war_deployment_directories | join('; ')) }},{{ csv_cell(audit.document_roots_found | join('; ')) }},{{ csv_cell(audit.classification) }},{{ csv_cell(audit.docker_running_container_count) }},{{ csv_cell(audit.podman_running_container_count) }},{{ csv_cell(audit.lxc_classic_running_container_count) }},{{ csv_cell(audit.lxd_running_container_count) }},{{ csv_cell(audit.kubernetes_pod_count) }},{{ csv_cell(audit.docker_scan_status) }},{{ csv_cell(audit.podman_scan_status) }},{{ csv_cell(audit.lxc_classic_scan_status) }},{{ csv_cell(audit.lxd_scan_status) }},{{ csv_cell(audit.kubernetes_scan_status) }},{{ csv_cell(audit.container_results | to_json) }},{{ csv_cell(audit.audit_data_source | defaul